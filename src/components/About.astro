---
import { Image } from "astro:assets";
import { about, site } from "../data/site";
import aboutPortrait from "../assets/portrait-about.png";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="shell about__grid">
    <div class="about__media reveal">
      <div class="about__frame">
        <div class="about__photo">
          <div class="about__fade">
            <Image
              class="about__image"
              src={aboutPortrait}
              alt={`${site.name} sitting on a rock in the mountains`}
              widths={[360, 576]}
              sizes="(min-width: 900px) 36vw, 90vw"
            />
          </div>
        </div>
        <span class="about__corner about__corner--tl" aria-hidden="true"></span>
        <span class="about__corner about__corner--br" aria-hidden="true"></span>
        <button class="about__tag" type="button" data-hunt="clock" tabindex="-1" aria-hidden="true">
          Off the clock
        </button>
      </div>
    </div>

    <div class="about__copy">
      <p class="section-label reveal">About</p>
      <h2 id="about-title" class="display about__title reveal reveal-delay-1">
        Insights people <em>actually use.</em>
      </h2>
      <p class="about__lead reveal reveal-delay-2">{about.lead}</p>
      {
        about.body.map((paragraph, index) => (
          <p class={`about__text reveal reveal-delay-${Math.min(index + 2, 3)}`}>{paragraph}</p>
        ))
      }

      <div class="about__stack reveal">
        <p class="about__stack-label">Stack</p>
        <ul class="about__skills">
          {
            about.skills.map((skill) => (
              <li>{skill}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
  }

  .about::before {
    content: "";
    position: absolute;
    inset: 10% auto auto -10%;
    width: 50vw;
    height: 50vw;
    max-width: 44rem;
    max-height: 44rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.12), transparent 65%);
    filter: blur(20px);
    pointer-events: none;
  }

  .about__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: start;
    }

    .about__media {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
    }
  }

  .about__media,
  .about__frame {
    position: relative;
  }

  /* Nested masks so the fade reaches zero exactly at the frame edge, even while the image zooms */
  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - var(--nav-h) - 4rem);
    min-height: 26rem;
    width: 100%;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 5%,
      rgba(0, 0, 0, 0.8) 11%,
      #000 17%,
      #000 83%,
      rgba(0, 0, 0, 0.8) 89%,
      rgba(0, 0, 0, 0.35) 95%,
      transparent 100%
    );
  }

  .about__fade {
    position: absolute;
    inset: 0;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 5%,
      rgba(0, 0, 0, 0.8) 11%,
      #000 17%,
      #000 83%,
      rgba(0, 0, 0, 0.8) 89%,
      rgba(0, 0, 0, 0.35) 95%,
      transparent 100%
    );
  }

  .about__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 82%;
    filter: saturate(0.92) contrast(1.02);
    transform: scale(1.1) translateX(-4.5%);
    transition:
      transform 1.6s var(--ease),
      filter 0.8s ease;
  }

  .about__media:hover .about__image {
    transform: scale(1.14) translateX(-4.5%);
    filter: saturate(1) contrast(1.04);
  }

  .about__corner {
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    border: 0 solid rgba(26, 28, 24, 0.45);
    z-index: 1;
    pointer-events: none;
  }

  .about__corner--tl {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .about__corner--br {
    right: 0;
    bottom: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .about__tag {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 999px;
    background: rgba(230, 227, 219, 0.78);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    cursor: default;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.4s var(--ease-spring);
  }

  :global(html[data-hunt="2"]) .about__tag {
    cursor: pointer;
    background: var(--accent);
    color: #f4f1ea;
    animation:
      tag-hint 1.6s var(--ease-in-out) infinite,
      tag-ring 1.6s linear infinite;
  }

  :global(html[data-hunt="2"]) .about__tag:hover {
    transform: scale(1.08);
  }

  @keyframes tag-hint {
    50% {
      box-shadow: 0 0 0 7px rgba(var(--accent-rgb), 0.22);
    }
  }

  /* Bursts of rattling with a pause between, like an alarm going off */
  @keyframes tag-ring {
    0%,
    40%,
    100% {
      rotate: 0deg;
      translate: 0 0;
    }
    4%,
    12%,
    20%,
    28%,
    36% {
      rotate: -7deg;
      translate: -1.5px -1px;
    }
    8%,
    16%,
    24%,
    32% {
      rotate: 7deg;
      translate: 1.5px -1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-hunt="2"]) .about__tag {
      animation: tag-hint 1.6s var(--ease-in-out) infinite;
    }
  }

  .about__title {
    font-size: clamp(2.8rem, 6vw, 5rem);
    max-width: 12ch;
  }

  .about__lead {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.2;
    color: var(--ink);
    max-width: 34rem;
  }

  .about__text {
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
    max-width: 40rem;
  }

  .about__text:last-of-type {
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--ink);
  }

  .about__stack {
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .about__stack-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .about__skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about__skills li {
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-soft);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }

  .about__skills li:hover {
    border-color: rgba(var(--accent-rgb), 0.5);
    color: var(--ink);
    background: rgba(var(--accent-rgb), 0.08);
  }
</style>
