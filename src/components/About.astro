---
import { Image } from "astro:assets";
import { about, site } from "../data/site";
import aboutPortrait from "../assets/portrait-about.png";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="shell about__grid">
    <div class="about__media reveal">
      <div class="about__photo">
        <Image
          class="about__image"
          src={aboutPortrait}
          alt={`${site.name} sitting on a rock in the mountains`}
          widths={[360, 576]}
          sizes="(min-width: 900px) 42vw, 100vw"
        />
      </div>
      <span class="about__tag" aria-hidden="true">Off the clock</span>
    </div>

    <div class="about__copy">
      <p class="section-label reveal">About</p>
      <h2 id="about-title" class="display about__title reveal reveal-delay-1">
        Insights people <em>actually use.</em>
      </h2>
      <p class="about__lead reveal reveal-delay-2">{about.lead}</p>
      {
        about.body.map((paragraph, index) => (
          <p class={`about__text reveal reveal-delay-${Math.min(index + 2, 3)}`}>{paragraph}</p>
        ))
      }

      <div class="about__stack reveal">
        <p class="about__stack-label">Stack</p>
        <ul class="about__skills">
          {
            about.skills.map((skill) => (
              <li>{skill}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
  }

  .about::before {
    content: "";
    position: absolute;
    inset: 10% auto auto -10%;
    width: 50vw;
    height: 50vw;
    max-width: 44rem;
    max-height: 44rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.12), transparent 65%);
    filter: blur(20px);
    pointer-events: none;
  }

  .about__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: start;
    }

    .about__media {
      position: sticky;
      top: calc(var(--nav-h) + 1rem);
      /* Bleed the photo out to the left edge of the viewport */
      margin-left: calc((min(100vw - 3rem, var(--max)) - 100vw) / 2);
    }
  }

  .about__media {
    position: relative;
  }

  /* Two nested masks: the wrapper fades top and bottom, the image fades toward the copy */
  .about__photo {
    position: relative;
    height: min(calc(100svh - var(--nav-h) - 2rem), 58rem);
    min-height: 32rem;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 80%, transparent 100%);
  }

  .about__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 72%;
    filter: saturate(0.92) contrast(1.02);
    mask-image: linear-gradient(
      to right,
      #000 0%,
      #000 44%,
      rgba(0, 0, 0, 0.75) 60%,
      rgba(0, 0, 0, 0.35) 74%,
      rgba(0, 0, 0, 0.1) 85%,
      transparent 92%
    );
    transform: scale(1.02);
    transition:
      transform 1.6s var(--ease),
      filter 0.8s ease;
  }

  .about__media:hover .about__image {
    transform: scale(1.06);
    filter: saturate(1) contrast(1.04);
  }

  @media (max-width: 899px) {
    .about__media {
      margin-inline: calc((min(100vw - 3rem, var(--max)) - 100vw) / 2);
    }

    .about__photo {
      height: min(80svh, 40rem);
      min-height: 0;
    }

    .about__image {
      mask-image: none;
    }
  }

  @media (max-width: 640px) {
    .about__media {
      margin-inline: -1rem;
    }
  }

  .about__tag {
    position: absolute;
    right: 18%;
    bottom: 12%;
    z-index: 1;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgba(230, 227, 219, 0.72);
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .about__title {
    font-size: clamp(2.8rem, 6vw, 5rem);
    max-width: 12ch;
  }

  .about__lead {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.2;
    color: var(--ink);
    max-width: 34rem;
  }

  .about__text {
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
    max-width: 40rem;
  }

  .about__text:last-of-type {
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    color: var(--ink);
  }

  .about__stack {
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .about__stack-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .about__skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about__skills li {
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-soft);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }

  .about__skills li:hover {
    border-color: rgba(var(--accent-rgb), 0.5);
    color: var(--ink);
    background: rgba(var(--accent-rgb), 0.08);
  }
</style>
