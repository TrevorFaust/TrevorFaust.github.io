---
import { Image } from "astro:assets";
import { about, site } from "../data/site";
import aboutPortrait from "../assets/portrait-about.png";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="shell about__grid">
    <div class="about__media reveal">
      <div class="about__photo">
        <Image
          class="about__image"
          src={aboutPortrait}
          alt={`${site.name} sitting on a rock in the mountains`}
          widths={[360, 540, 720]}
          sizes="(min-width: 900px) 32vw, 80vw"
        />
      </div>
      <ul class="about__skills">
        {
          about.skills.map((skill) => (
            <li>{skill}</li>
          ))
        }
      </ul>
    </div>

    <div class="about__copy">
      <p class="section-label reveal">About</p>
      <h2 id="about-title" class="display about__title reveal reveal-delay-1">
        Insights people<br />use.
      </h2>
      <p class="about__lead reveal reveal-delay-2">{about.lead}</p>
      {
        about.body.map((paragraph, index) => (
          <p class={`about__text reveal reveal-delay-${Math.min(index + 2, 3)}`}>{paragraph}</p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }

  .about__photo {
    position: relative;
    aspect-ratio: 5 / 6;
    border-radius: calc(var(--radius) + 0.25rem);
    border: 1px solid var(--line);
    background: #cfc9bc;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .about__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 78%;
  }

  .about__skills {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .about__skills li {
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .about__title {
    font-size: clamp(2.4rem, 6vw, 4rem);
  }

  .about__lead {
    margin: 1.4rem 0 0;
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    font-weight: 500;
    color: var(--ink);
    max-width: 36rem;
  }

  .about__text {
    margin: 1.15rem 0 0;
    color: var(--ink-soft);
    max-width: 40rem;
  }
</style>
