---
import { Image } from "astro:assets";
import { site } from "../data/site";
import heroPortrait from "../assets/portrait-hero.png";
import heroCutout from "../assets/portrait-hero-cutout.png";

const [firstName, ...rest] = site.name.split(" ");
const lastName = rest.join(" ");
const photoSizes = "(min-width: 960px) 46svh, 75vw";
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero__ambient" aria-hidden="true">
    <Image class="hero__ambient-img" src={heroPortrait} alt="" widths={[240]} sizes="240px" loading="eager" />
  </div>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__stage">
    <div class="hero__photo hero__photo--scene layer-photo" aria-hidden="true">
      <Image
        class="hero__img"
        src={heroPortrait}
        alt=""
        widths={[320, 511]}
        sizes={photoSizes}
        loading="eager"
      />
      <span class="hero__scan"></span>
    </div>

    <h1 id="hero-title" class="hero__name layer-name">
      <span class="hero__line hero__line--1">{firstName}</span>{" "}
      <span class="hero__line hero__line--2">{lastName}</span>
    </h1>

    <div class="hero__photo hero__photo--figure layer-photo">
      <Image
        class="hero__img"
        src={heroCutout}
        alt={`${site.name} on the beach at sunset`}
        widths={[320, 511]}
        sizes={photoSizes}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__reticle" aria-hidden="true">
        <span class="hero__reticle-label">TF—01</span>
        <i></i><i></i><i></i><i></i>
      </div>
    </div>

    <div class="hero__name hero__name--ghost layer-name" aria-hidden="true">
      <span class="hero__line hero__line--1">{firstName}</span>
      <span class="hero__line hero__line--2">{lastName}</span>
    </div>
  </div>

  <div class="hero__hud" aria-hidden="true">
    <span>{site.location}</span>
    <span class="hero__hud-dim">{site.coordinates}</span>
  </div>

  <ul class="hero__interests" aria-label="Interests">
    {
      site.interests.map((interest, index) => (
        <li>
          <span class="hero__interest-num">{String(index + 1).padStart(2, "0")}</span>
          {interest}
        </li>
      ))
    }
  </ul>

  <div class="hero__copy">
    <p class="hero__kicker">
      <span class="hero__kicker-line"></span>
      Data analytics · Sports &amp; tech
    </p>
    <p class="hero__lead">{site.tagline}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#projects">
        View projects <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href="#about">About me</a>
    </div>
    <p class="hero__status">
      <span class="hero__status-dot" aria-hidden="true"></span>
      Open to data analytics roles
    </p>
  </div>

  <a class="hero__scroll" href="#projects" aria-label="Scroll to projects">
    <span>Scroll</span>
    <span class="hero__scroll-track" aria-hidden="true"><span></span></span>
  </a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && !reduceMotion) {
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let frame = 0;

    const tick = () => {
      x += (targetX - x) * 0.07;
      y += (targetY - y) * 0.07;
      hero.style.setProperty("--mx", x.toFixed(4));
      hero.style.setProperty("--my", y.toFixed(4));
      frame =
        Math.abs(targetX - x) > 0.0005 || Math.abs(targetY - y) > 0.0005
          ? requestAnimationFrame(tick)
          : 0;
    };

    const kick = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    hero.addEventListener("pointermove", (event) => {
      if (event.pointerType !== "mouse") return;
      const rect = hero.getBoundingClientRect();
      const px = event.clientX - rect.left;
      const py = event.clientY - rect.top;
      targetX = (px / rect.width) * 2 - 1;
      targetY = (py / rect.height) * 2 - 1;
      hero.style.setProperty("--gx", `${px}px`);
      hero.style.setProperty("--gy", `${py}px`);
      kick();
    });

    hero.addEventListener("pointerleave", () => {
      targetX = 0;
      targetY = 0;
      kick();
    });

    let scrollFrame = 0;
    const onScroll = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        const progress = Math.min(1, Math.max(0, window.scrollY / hero.offsetHeight));
        hero.style.setProperty("--sp", progress.toFixed(4));
        scrollFrame = 0;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .hero {
    --mx: 0;
    --my: 0;
    --sp: 0;
    --hh: max(100svh, 46rem);
    --ph: calc(var(--hh) * 0.96);
    --pw: calc(var(--ph) * 0.4991);
    --cx: 63%;
    --fs: min(calc(var(--ph) * 0.36), 21vw);
    --edge: max(1.5rem, calc((100% - var(--max)) / 2));

    position: relative;
    height: var(--hh);
    overflow: clip;
    isolation: isolate;
  }

  /* Blurred wash of the photo so its colors bleed across the whole hero */
  .hero__ambient {
    position: absolute;
    inset: -10%;
    z-index: -2;
    opacity: 0;
    mask-image: radial-gradient(ellipse 55% 70% at var(--cx) 45%, #000 10%, transparent 75%);
    animation: fade-in 2.4s var(--ease) 0.1s forwards;
    transform: translate3d(calc(var(--mx) * -28px), calc(var(--my) * -18px), 0);
  }

  .hero__ambient-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(70px) saturate(1.4);
    opacity: 0.55;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      520px circle at var(--gx, 63%) var(--gy, 38%),
      rgba(var(--sun-rgb), 0.09),
      transparent 65%
    );
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__photo {
    position: absolute;
    bottom: 0;
    left: calc(var(--cx) - var(--pw) / 2);
    width: var(--pw);
    height: var(--ph);
  }

  .layer-photo {
    transform: translate3d(
      calc(var(--mx) * -10px),
      calc(var(--my) * -6px + var(--sp) * 70px),
      0
    );
    will-change: transform;
  }

  .layer-name {
    transform: translate3d(
      calc(var(--mx) * 22px),
      calc(var(--my) * 12px + var(--sp) * -160px),
      0
    );
    will-change: transform;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photo--scene {
    z-index: 1;
    mask-image: radial-gradient(ellipse 50% 41% at 50% 43%, #000 30%, transparent 100%);
  }

  .hero__photo--scene .hero__img {
    filter: brightness(0.6) saturate(0.85) contrast(1.05);
    clip-path: inset(100% 0 0 0);
    animation: wipe-up 1.6s var(--ease-in-out) 0.15s forwards;
  }

  .hero__scan {
    position: absolute;
    left: -20%;
    right: -20%;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--sun-rgb), 0.9), transparent);
    box-shadow: 0 0 18px 2px rgba(var(--sun-rgb), 0.45);
    opacity: 0;
    animation: scan 9s var(--ease-in-out) 1.2s infinite;
  }

  .hero__photo--figure {
    z-index: 3;
    mask-image: linear-gradient(to bottom, #000 62%, transparent 94%);
  }

  .hero__photo--figure .hero__img {
    filter: drop-shadow(0 0 40px rgba(var(--sun-rgb), 0.12));
    opacity: 0;
    animation: materialize 1.5s var(--ease) 0.75s forwards;
  }

  .hero__name {
    position: absolute;
    left: var(--cx);
    top: calc(var(--hh) - var(--ph));
    width: 0;
    height: var(--ph);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs);
    line-height: 0.8;
    letter-spacing: -0.035em;
    z-index: 2;
  }

  .hero__line {
    position: absolute;
    display: block;
    white-space: nowrap;
    padding: 0.06em 0.1em 0.12em;
  }

  .hero__line--1 {
    right: calc(var(--ph) * 0.005);
    top: calc(var(--ph) * 0.17);
    color: var(--ink);
    background: linear-gradient(180deg, #fbf7f0 30%, #c9c4ba 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__line--2 {
    left: calc(var(--ph) * -0.11);
    top: calc(var(--ph) * 0.45);
    font-style: italic;
    background: var(--grad-sun);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__name:not(.hero__name--ghost) .hero__line {
    opacity: 0;
    animation: rise 1.4s var(--ease) forwards;
  }

  .hero__name:not(.hero__name--ghost) .hero__line--1 {
    animation-delay: 0.35s;
  }

  .hero__name:not(.hero__name--ghost) .hero__line--2 {
    animation-delay: 0.55s;
  }

  /* Outline copy drawn over the figure so the letters read as wrapping around him */
  .hero__name--ghost {
    z-index: 4;
  }

  .hero__name--ghost .hero__line {
    background: none;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 1px rgba(241, 236, 227, 0.5);
    opacity: 0;
    animation: fade-in 1.2s var(--ease) 1.7s forwards;
  }

  .hero__name--ghost .hero__line--2 {
    -webkit-text-stroke-color: rgba(var(--sun-rgb), 0.75);
  }

  .hero__reticle {
    position: absolute;
    left: 40%;
    top: 13.5%;
    width: 34%;
    height: 21%;
    opacity: 0;
    animation: reticle 1s var(--ease) 1.9s forwards;
  }

  .hero__reticle i {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(241, 236, 227, 0.6);
    border-style: solid;
    border-width: 0;
  }

  .hero__reticle i:nth-of-type(1) {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .hero__reticle i:nth-of-type(2) {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .hero__reticle i:nth-of-type(3) {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .hero__reticle i:nth-of-type(4) {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .hero__reticle-label {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.4rem);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    color: rgba(241, 236, 227, 0.7);
  }

  .hero__hud {
    position: absolute;
    top: calc(var(--nav-h) + 1.75rem);
    left: var(--edge);
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0;
    animation: fade-in 1s var(--ease) 1.2s forwards;
  }

  .hero__hud-dim {
    color: var(--ink-faint);
  }

  .hero__interests {
    position: absolute;
    right: var(--edge);
    top: calc(var(--nav-h) + 1.75rem);
    z-index: 5;
    display: none;
    flex-direction: column;
    gap: 0.55rem;
    margin: 0;
    padding: 0 1.1rem 0 0;
    list-style: none;
    border-right: 1px solid var(--line);
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0;
    animation: fade-in 1s var(--ease) 1.5s forwards;
  }

  .hero__interests li {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .hero__interest-num {
    color: var(--sun);
  }

  .hero__copy {
    position: absolute;
    left: var(--edge);
    bottom: max(2.5rem, 7svh);
    z-index: 6;
    width: min(29rem, calc(var(--cx) - var(--ph) * 0.19 - var(--edge) - 2rem));
  }

  .hero__copy > * {
    opacity: 0;
    animation: rise-soft 1.1s var(--ease) forwards;
  }

  .hero__copy > :nth-child(1) {
    animation-delay: 1s;
  }

  .hero__copy > :nth-child(2) {
    animation-delay: 1.1s;
  }

  .hero__copy > :nth-child(3) {
    animation-delay: 1.2s;
  }

  .hero__copy > :nth-child(4) {
    animation-delay: 1.3s;
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sun);
  }

  .hero__kicker-line {
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  .hero__lead {
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    font-weight: 300;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero__status-dot {
    position: relative;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 12px rgba(var(--signal-rgb), 0.8);
  }

  .hero__status-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid rgba(var(--signal-rgb), 0.6);
    animation: ping 2.4s var(--ease) infinite;
  }

  .hero__scroll {
    position: absolute;
    right: var(--edge);
    bottom: max(2.5rem, 7svh);
    z-index: 6;
    display: none;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    opacity: 0;
    animation: fade-in 1s var(--ease) 1.8s forwards;
    transition: color 0.3s ease;
  }

  .hero__scroll:hover {
    color: var(--ink);
  }

  .hero__scroll-track {
    position: relative;
    width: 3.5rem;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .hero__scroll-track span {
    position: absolute;
    inset: 0;
    background: var(--sun);
    transform: translateX(-100%);
    animation: track 2.4s var(--ease-in-out) infinite;
  }

  @media (min-width: 960px) {
    .hero__interests,
    .hero__scroll {
      display: flex;
    }
  }

  @media (max-width: 959px) {
    .hero {
      --ph: min(150vw, 82svh);
      --cx: 50%;
      --fs: 27vw;
      height: auto;
      padding: calc(var(--nav-h) + 1rem) 0 3.5rem;
    }

    .hero__stage {
      position: relative;
      inset: auto;
      height: var(--ph);
    }

    .hero__name {
      top: 0;
      left: 0;
      right: 0;
      width: auto;
    }

    .hero__line--1 {
      right: auto;
      left: 3%;
      top: calc(var(--ph) * 0.31);
    }

    .hero__line--2 {
      left: auto;
      right: 3%;
      top: calc(var(--ph) * 0.49);
    }

    .hero__hud {
      display: none;
    }

    .hero__copy {
      position: relative;
      left: auto;
      bottom: auto;
      width: min(100% - 2rem, 36rem);
      margin: calc(var(--ph) * -0.16) auto 0;
    }

    .layer-photo {
      transform: translate3d(0, calc(var(--sp) * 40px), 0);
    }

    .layer-name {
      transform: translate3d(0, calc(var(--sp) * -80px), 0);
    }
  }

  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes wipe-up {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.28em);
      filter: blur(16px);
      letter-spacing: 0.04em;
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
      letter-spacing: -0.035em;
    }
  }

  @keyframes rise-soft {
    from {
      opacity: 0;
      transform: translateY(1rem);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @keyframes materialize {
    from {
      opacity: 0;
      filter: brightness(2.2) blur(10px) drop-shadow(0 0 40px rgba(var(--sun-rgb), 0.12));
    }
    to {
      opacity: 1;
      filter: brightness(1) blur(0) drop-shadow(0 0 40px rgba(var(--sun-rgb), 0.12));
    }
  }

  @keyframes reticle {
    from {
      opacity: 0;
      transform: scale(1.25);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes scan {
    0% {
      top: 0;
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    30% {
      opacity: 0.8;
    }
    36% {
      top: 100%;
      opacity: 0;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 1;
    }
    80%,
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @keyframes track {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(100%);
    }
  }
</style>
