---
import { Image } from "astro:assets";
import { site } from "../data/site";
import heroPortrait from "../assets/portrait-hero.png";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="section-label reveal">Data analytics in sports and tech</p>
      <h1 id="hero-title" class="display hero__title reveal reveal-delay-1">
        {site.name}
      </h1>
      <p class="lead reveal reveal-delay-2">{site.tagline}</p>
      <div class="hero__actions reveal reveal-delay-3">
        <a class="btn btn--primary" href="#projects">View projects</a>
        <a class="btn btn--ghost" href="#about">About me</a>
      </div>
    </div>

    <aside class="hero__aside reveal reveal-delay-2">
      <div class="portrait">
        <div class="portrait__frame">
          <Image
            class="portrait__image"
            src={heroPortrait}
            alt={`${site.name} on the beach at sunset`}
            widths={[360, 540, 720]}
            sizes="(min-width: 900px) 28vw, 80vw"
          />
        </div>
        <div class="portrait__meta">
          <span class="portrait__label">Interests</span>
          <span class="portrait__interests">Sports · Technology · Sustainability · Energy</span>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(3rem, 8vw, 5rem) 2rem;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: end;
  }

  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
    }
  }

  .hero__title {
    font-size: clamp(3.4rem, 10vw, 7rem);
    max-width: 10ch;
  }

  .hero__copy .lead {
    max-width: 42rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      transform 0.25s var(--ease),
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn--primary {
    background: var(--accent);
    color: #f4f1ea;
  }

  .btn--primary:hover {
    background: var(--accent-soft);
  }

  .btn--ghost {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.25);
    color: var(--ink);
  }

  .btn--ghost:hover {
    border-color: rgba(26, 28, 24, 0.28);
    background: rgba(255, 255, 255, 0.45);
  }

  .portrait {
    display: grid;
    gap: 1rem;
  }

  .portrait__frame {
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--radius) + 0.35rem);
    background: #cfc9bc;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }

  .portrait__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .portrait__frame::after {
    content: "";
    position: absolute;
    inset: 0.85rem;
    border: 1px solid rgba(244, 241, 234, 0.28);
    border-radius: var(--radius);
    pointer-events: none;
  }

  .portrait__meta {
    display: grid;
    gap: 0.3rem;
    color: var(--ink-faint);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    justify-items: center;
  }

  .portrait__label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .portrait__interests {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
</style>
