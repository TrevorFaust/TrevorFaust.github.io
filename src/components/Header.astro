---
import { Image } from "astro:assets";
import { site } from "../data/site";
import logo from "../assets/logo-tf.png";
---

<header class="nav" data-nav>
  <div class="shell nav__inner">
    <a class="nav__brand" href="#top" aria-label={`${site.name} home`}>
      <Image class="nav__mark" src={logo} alt="" widths={[96, 144, 192]} sizes="52px" />
    </a>
    <nav class="nav__links" aria-label="Primary">
      <a href="#projects">Projects</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="nav__cta" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
      LinkedIn <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const update = () => nav.classList.toggle("is-scrolled", window.scrollY > 24);
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background 0.4s ease,
      border-color 0.4s ease,
      backdrop-filter 0.4s ease;
  }

  .nav.is-scrolled {
    background: rgba(230, 227, 219, 0.78);
    border-bottom-color: var(--line);
    backdrop-filter: blur(16px) saturate(1.2);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    text-decoration: none;
    border-radius: 0.35rem;
    transition: transform 0.4s var(--ease);
  }

  .nav__brand:hover {
    transform: skewX(-8deg);
  }

  .nav__mark {
    display: block;
    height: 2rem;
    width: auto;
  }

  .nav__links {
    display: none;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.45);
    backdrop-filter: blur(12px);
  }

  .nav__links a {
    padding: 0.45rem 1.05rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
    transition:
      color 0.25s ease,
      background 0.25s ease;
  }

  .nav__links a:hover {
    color: var(--ink);
    background: rgba(255, 253, 248, 0.9);
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    background: var(--ink);
    color: #f4f1ea;
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    transition:
      background 0.25s ease,
      transform 0.25s var(--ease);
  }

  .nav__cta:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }

  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }
</style>
