---
import { analyticsStudies, site } from "../data/site";

const appHref = site.links.analytics;
---

<section class="section studies" id="analytics" aria-labelledby="analytics-title">
  <div class="shell">
    <div class="studies__intro">
      <p class="section-label reveal">Analytics</p>
      <h2 id="analytics-title" class="display studies__title reveal reveal-delay-1">
        Three studies, <em>one app.</em>
      </h2>
      <p class="studies__caption reveal reveal-delay-2">
        Baseball scores batted balls against the result and against Savant. Basketball asks whether
        back-to-backs and home court move true shooting. Football walks every regular-season flag
        since 1999.
      </p>
      <div class="studies__actions reveal reveal-delay-3">
        <a class="btn btn--primary" href={appHref} target="_blank" rel="noopener noreferrer">
          Open analytics <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <ol class="study-list">
      {
        analyticsStudies.map((study, index) => (
          <li class="study reveal">
            <a
              class="study__link"
              href={`${appHref}${study.path}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="study__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="study__copy">
                <span class="study__sport">{study.sport}</span>
                <span class="study__name">{study.title}</span>
              </span>
              <span class="study__dek">{study.dek}</span>
              <span class="study__go" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .studies {
    scroll-margin-top: 1rem;
  }

  .studies__intro {
    display: grid;
    gap: 0;
  }

  .studies__title {
    font-size: clamp(3rem, 8vw, 6.5rem);
    max-width: 12ch;
  }

  .studies__caption {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
  }

  .studies__actions {
    margin-top: 1.75rem;
  }

  @media (min-width: 900px) {
    .studies__intro {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
      grid-template-areas:
        "label label"
        "title caption"
        "actions caption";
      column-gap: clamp(2rem, 5vw, 4.5rem);
      align-items: end;
    }

    .studies__intro .section-label {
      grid-area: label;
    }

    .studies__title {
      grid-area: title;
    }

    .studies__caption {
      grid-area: caption;
      margin: 0 0 0.35rem;
      padding-left: 1.1rem;
      border-left: 2px solid var(--accent);
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.25rem, 1.8vw, 1.5rem);
      line-height: 1.3;
    }

    .studies__actions {
      grid-area: actions;
      margin-top: 1.75rem;
    }
  }

  .study-list {
    list-style: none;
    margin: clamp(2.75rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .study__link {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "index copy go"
      "dek dek dek";
    gap: 0.35rem 1rem;
    align-items: center;
    padding: clamp(1.35rem, 3vw, 1.85rem) clamp(0.35rem, 1.5vw, 1rem);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }

  .study__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--grad-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .study__link:hover::after,
  .study__link:focus-visible::after {
    transform: scaleX(1);
  }

  .study__index {
    grid-area: index;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }

  .study__copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .study__sport {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .study__name {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    transition:
      transform 0.45s var(--ease),
      font-style 0.2s ease;
  }

  .study__link:hover .study__name,
  .study__link:focus-visible .study__name {
    transform: translateX(0.3rem);
    font-style: italic;
  }

  .study__dek {
    grid-area: dek;
    max-width: 38rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .study__go {
    grid-area: go;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-size: 0.95rem;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.5s var(--ease);
  }

  .study__link:hover .study__go,
  .study__link:focus-visible .study__go {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    transform: rotate(45deg);
  }

  @media (min-width: 860px) {
    .study__link {
      grid-template-columns: 3.25rem minmax(16rem, 1.15fr) minmax(0, 1.2fr) auto;
      grid-template-areas: "index copy dek go";
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
      align-items: center;
    }

    .study__dek {
      align-self: center;
    }
  }
</style>
