---
import { analyticsStudies, site } from "../data/site";
import football from "../assets/mark-football.svg?url";
import baseball from "../assets/mark-baseball.svg?url";
import basketball from "../assets/mark-basketball.svg?url";
import catalog from "../assets/mark-catalog.svg?url";

const appHref = site.links.analytics;

const marks = {
  football,
  baseball,
  basketball,
  catalog,
} as const;
---

<section class="section studies" id="analytics" aria-labelledby="analytics-title">
  <div class="shell">
    <div class="studies__intro">
      <p class="section-label reveal">Analytics</p>
      <h2 id="analytics-title" class="display studies__title reveal reveal-delay-1">
        Personal studies<br /><em>I wanted to run.</em>
      </h2>
      <p class="studies__caption reveal reveal-delay-2">
        Analytic studies based on the questions I wanted answered about what I care about.
      </p>
    </div>

    <ol class="study-list">
      {
        analyticsStudies.map((study) => {
          const href = study.path ? `${appHref}${study.path}` : appHref;
          return (
            <li class="study reveal" data-spotlight>
              <div class="study__meta">
                <a class="study__mark" href={href} draggable="false" tabindex="-1" aria-hidden="true">
                  <img class="study__icon" src={marks[study.icon]} alt="" draggable="false" />
                </a>
              </div>

              <div class="study__main">
                <p class="study__sport">{study.sport}</p>
                <h3 class="study__name">
                  <a href={href} draggable="false">
                    {study.title}
                  </a>
                </h3>
                <p class="study__dek">{study.dek}</p>
              </div>

              <a class="study__open" href={href} draggable="false">
                Open
                <span class="study__go" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("#analytics [data-spotlight]").forEach((card) => {
    card.addEventListener("pointermove", (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--x", `${event.clientX - rect.left}px`);
      card.style.setProperty("--y", `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  .studies {
    scroll-margin-top: 1rem;
  }

  .studies__intro {
    display: grid;
    gap: 0;
  }

  .studies__title {
    font-size: clamp(2.7rem, 6.2vw, 4.8rem);
    max-width: 20ch;
  }

  .studies__caption {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .studies__intro {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
      grid-template-areas:
        "label label"
        "title caption";
      column-gap: clamp(2rem, 5vw, 4.5rem);
      align-items: end;
    }

    .studies__intro .section-label {
      grid-area: label;
    }

    .studies__title {
      grid-area: title;
    }

    .studies__caption {
      grid-area: caption;
      margin: 0 0 0.35rem;
      padding-left: 1.1rem;
      border-left: 2px solid var(--accent);
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(1.25rem, 1.8vw, 1.5rem);
      line-height: 1.3;
    }
  }

  .study-list {
    list-style: none;
    margin: clamp(2.75rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .study {
    --x: 50%;
    --y: 50%;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem 1.15rem;
    align-items: center;
    padding: clamp(1.35rem, 3vw, 1.85rem) clamp(0.35rem, 1.5vw, 1rem);
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }

  .study::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--x) var(--y), rgba(var(--glow-rgb), 0.85), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .study::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--grad-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
    pointer-events: none;
  }

  .study:hover::before {
    opacity: 1;
  }

  .study:hover::after {
    transform: scaleX(1);
  }

  .study__mark {
    position: relative;
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1rem;
    background: linear-gradient(145deg, #fdfbf7, #efebe3);
    box-shadow:
      0 0 0 1px var(--line),
      0 14px 30px -16px rgba(26, 28, 24, 0.35);
    transition:
      transform 0.55s var(--ease-spring),
      box-shadow 0.55s var(--ease);
    -webkit-user-drag: none;
  }

  .study:hover .study__mark {
    transform: scale(1.14);
    box-shadow:
      0 0 0 1px rgba(var(--accent-rgb), 0.25),
      0 22px 40px -18px rgba(26, 28, 24, 0.45);
  }

  .study:has(a:active) .study__mark {
    transform: scale(0.88);
    transition-duration: 0.12s;
  }

  .study__icon {
    position: absolute;
    inset: 0.65rem;
    width: calc(100% - 1.3rem);
    height: calc(100% - 1.3rem);
    -webkit-user-drag: none;
    user-select: none;
  }

  .study__main {
    min-width: 0;
  }

  .study__sport {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .study__name {
    margin: 0.3rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .study__name a {
    color: inherit;
    text-decoration: none;
    user-select: text;
    -webkit-user-drag: none;
  }

  .study:hover .study__name a {
    font-style: italic;
  }

  .study__dek {
    max-width: 40rem;
    margin: 0.55rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    user-select: text;
    cursor: text;
  }

  .study__open {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    justify-self: end;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    -webkit-user-drag: none;
  }

  .study__go {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.45s var(--ease);
  }

  .study__open:hover .study__go,
  .study:hover .study__open .study__go {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .study {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "mark main"
        "open open";
    }

    .study__meta {
      grid-area: mark;
    }

    .study__main {
      grid-area: main;
    }

    .study__open {
      grid-area: open;
      justify-self: start;
    }
  }
</style>
