---
import { editorial, site } from "../../data/site";

const prettyUrl = (url: string) =>
  url.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");

const contacts = [
  { label: "Email", href: `mailto:${site.email}`, value: site.email, external: false },
  { label: "LinkedIn", href: site.links.linkedin, value: prettyUrl(site.links.linkedin), external: true },
  { label: "Substack", href: site.links.substack, value: prettyUrl(site.links.substack), external: true },
  { label: "GitHub", href: site.links.github, value: prettyUrl(site.links.github), external: true },
];
---

<section class="ed-section hello" id="contact" aria-labelledby="contact-title">
  <div class="ed-shell hello__inner reveal">
    <p class="ed-kicker">Contact</p>
    <h2 id="contact-title" class="hello__title">{editorial.hello}</h2>
    <p class="hello__lede">
      Reach out about data analytics roles in sports, technology, or energy and
      sustainability, or to talk shop about building things people use.
    </p>
    <ul class="hello__links">
      {
        contacts.map((contact) => (
          <li>
            <a
              href={contact.href}
              target={contact.external ? "_blank" : undefined}
              rel={contact.external ? "noopener noreferrer" : undefined}
            >
              <span class="hello__kind">{contact.label}</span>
              <span class="hello__value">
                {contact.value}
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="colophon">
  <div class="ed-shell colophon__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>{site.location}</p>
  </div>
</footer>

<style>
  .hello__inner {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--ed-line);
  }

  .hello__title {
    margin: 0.8rem 0 0;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }

  .hello__lede {
    margin: 1.5rem 0 0;
    max-width: 36rem;
    color: var(--ed-ink-soft);
  }

  .hello__links {
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .hello__links a {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--ed-line);
    text-decoration: none;
    min-height: 4.5rem;
    align-content: center;
    transition: color 0.2s ease;
  }

  .hello__links li:last-child a {
    border-bottom: 1px solid var(--ed-line);
  }

  .hello__links a:hover {
    color: var(--ed-accent);
  }

  .hello__kind {
    font-family: var(--ed-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ed-ink-faint);
  }

  .hello__value {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.15rem;
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  .colophon {
    position: relative;
    z-index: 1;
    padding: 1.75rem 0 2.75rem;
  }

  .colophon__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ed-ink-faint);
    font-family: var(--ed-mono);
    font-size: 0.75rem;
  }

  .colophon p {
    margin: 0;
  }

  @media (min-width: 720px) {
    .hello__links {
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
    }

    .hello__links a {
      border-bottom: 1px solid var(--ed-line);
    }
  }
</style>
