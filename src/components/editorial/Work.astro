---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { editorial, projects } from "../../data/site";
import draftdnaIcon from "../../assets/mark-draftdna.png";
import scoutdnaIcon from "../../assets/mark-scoutdna.webp";
import hustlehunterIcon from "../../assets/mark-hustlehunter.webp";
import leaselocatorIcon from "../../assets/mark-leaselocator.webp";
import fantasyBlogIcon from "../../assets/mark-fantasy-blog.webp";

const projectIcons: Record<(typeof projects)[number]["slug"], ImageMetadata> = {
  draftdna: draftdnaIcon,
  scoutdna: scoutdnaIcon,
  "job-search": hustlehunterIcon,
  "apartment-hunt": leaselocatorIcon,
  "fantasy-league-blog": fantasyBlogIcon,
};

const visibleProjects = projects.filter((project) => !("hidden" in project && project.hidden));
const flagships = new Set<string>(editorial.flagships);

const icons = {
  Persistent: `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="4" y="10.5" width="16" height="4" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="4" y="16" width="16" height="3" rx="1" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`,
  Modular: `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7.5" height="7.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="3.5" width="7.5" height="7.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="3.5" y="13" width="7.5" height="7.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="13" y="13" width="7.5" height="7.5" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`,
  Scalable: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M10 19V5M15 19v-7M20 19V7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>`,
  Coverage: `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 12h16M12 4c2.8 2.6 2.8 13.4 0 16M12 4c-2.8 2.6-2.8 13.4 0 16" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  Extracted: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h9M5 18h11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/><circle cx="18" cy="12" r="2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`,
  Composed: `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h12v14H6z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 9h6M9 13h6M9 17h3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`,
} as const;

type CapLabel = keyof typeof icons;
---

<section class="ed-section work" id="work" aria-labelledby="work-title">
  <div class="ed-shell">
    <div class="work__intro reveal">
      <p class="ed-kicker">Work</p>
      <h2 id="work-title" class="work__title">What I built and shipped.</h2>
    </div>

    <div class="work__list">
      {
        visibleProjects.map((project, index) => {
          const isFlagship = flagships.has(project.slug);
          const category = editorial.categories[project.slug];
          const caps = isFlagship
            ? editorial.capabilities[project.slug as keyof typeof editorial.capabilities]
            : null;
          const spec = isFlagship
            ? editorial.specs[project.slug as keyof typeof editorial.specs]
            : null;
          const icon = projectIcons[project.slug];
          const n = String(index + 1).padStart(2, "0");

          if (isFlagship && caps && spec) {
            return (
              <article class="flagship reveal" id={project.slug}>
                <header class="flagship__head">
                  <p class="flagship__index" aria-hidden="true">{n}</p>
                  <div class="flagship__ident">
                    <Image
                      class="flagship__mark"
                      src={icon}
                      alt=""
                      widths={[96, 144]}
                      sizes="56px"
                    />
                    <div>
                      <p class="flagship__cat">{category}</p>
                      <h3 class="flagship__name">{project.title}</h3>
                    </div>
                  </div>
                </header>

                <div class="flagship__grid">
                  <div class="flagship__brief">
                    <p class="ed-kicker">In brief</p>
                    <p class="flagship__copy">{project.blurb}</p>
                    <p class="flagship__copy flagship__copy--soft">{project.detail}</p>
                  </div>

                  <ul class="caps">
                    {caps.map((cap) => (
                      <li class="caps__item">
                        <span class="caps__icon" set:html={icons[cap.label as CapLabel]} />
                        <span>
                          <strong>{cap.label}</strong>
                          <span>{cap.detail}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>

                <dl class="spec">
                  <div>
                    <dt>Stack</dt>
                    <dd>{spec.stack}</dd>
                  </div>
                  <div>
                    <dt>Scale</dt>
                    <dd>{spec.scale}</dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd>{spec.status}</dd>
                  </div>
                </dl>

                <div class="work-links">
                  <a href={project.href} target="_blank" rel="noopener noreferrer">
                    {project.href.includes("github.com") ? "View repo" : "Open live"}
                    <span aria-hidden="true">↗</span>
                  </a>
                  {project.repo !== project.href && (
                    <a class="is-mute" href={project.repo} target="_blank" rel="noopener noreferrer">
                      GitHub
                    </a>
                  )}
                </div>
              </article>
            );
          }

          return (
            <article class="card reveal">
              <div class="card__top">
                <p class="card__index" aria-hidden="true">{n}</p>
                <Image class="card__mark" src={icon} alt="" widths={[120, 180]} sizes="72px" />
              </div>
              <p class="card__cat">{category}</p>
              <h3 class="card__name">{project.title}</h3>
              <p class="card__blurb">{project.blurb}</p>
              <p class="card__detail">{project.detail}</p>
              <div class="work-links">
                <a href={project.href} target="_blank" rel="noopener noreferrer">
                  {project.href.includes("github.com") ? "View repo" : "Open live"}
                  <span aria-hidden="true">↗</span>
                </a>
                {project.repo !== project.href && (
                  <a class="is-mute" href={project.repo} target="_blank" rel="noopener noreferrer">
                    GitHub
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .work__title {
    margin: 0.7rem 0 0;
    max-width: 12ch;
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .work__list {
    display: grid;
    gap: 1.1rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .flagship,
  .card {
    border: 1px solid var(--ed-line);
    background: color-mix(in srgb, var(--ed-bg-raised) 78%, transparent);
    transition:
      transform 0.35s var(--ed-ease),
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .flagship:hover,
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--ed-accent) 45%, var(--ed-line));
    background: var(--ed-bg-raised);
  }

  .flagship {
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }

  .flagship__head {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .flagship__index,
  .card__index {
    margin: 0;
    font-family: var(--ed-mono);
    font-size: 0.78rem;
    color: var(--ed-accent);
    letter-spacing: 0.08em;
  }

  .flagship__ident {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .flagship__mark,
  .card__mark {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .flagship__cat,
  .card__cat {
    margin: 0 0 0.2rem;
    color: var(--ed-accent);
    font-family: var(--ed-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .flagship__name {
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .flagship__grid {
    display: grid;
    gap: 1.75rem;
  }

  .flagship__copy {
    margin: 0.85rem 0 0;
    max-width: 40rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .flagship__copy--soft {
    color: var(--ed-ink-soft);
    font-weight: 400;
  }

  .caps {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    display: grid;
    gap: 1rem;
    border-top: 1px solid var(--ed-line);
  }

  .caps__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .caps__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--ed-accent);
    border: 1px solid var(--ed-line);
  }

  .caps__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .caps__item strong {
    display: block;
    font-size: 0.92rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .caps__item span span {
    display: block;
    margin-top: 0.15rem;
    color: var(--ed-ink-soft);
    font-size: 0.92rem;
  }

  .spec {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding: 1.2rem 0 0;
    border-top: 1px solid var(--ed-line);
  }

  .spec div {
    display: grid;
    gap: 0.25rem;
  }

  .spec dt {
    font-family: var(--ed-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ed-ink-faint);
  }

  .spec dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .card {
    display: grid;
    padding: clamp(1.3rem, 3vw, 1.8rem);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }

  .card__name {
    margin: 0;
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .card__blurb {
    margin: 0.85rem 0 0;
    font-weight: 500;
  }

  .card__detail {
    margin: 0.65rem 0 0;
    color: var(--ed-ink-soft);
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 1.4rem;
  }

  .work-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    color: var(--ed-accent);
    font-weight: 650;
    text-decoration: none;
  }

  .work-links a:hover {
    color: var(--ed-accent-soft);
  }

  .work-links .is-mute {
    color: var(--ed-ink-faint);
    font-weight: 500;
  }

  @media (min-width: 800px) {
    .work__list {
      grid-template-columns: 1fr 1fr;
    }

    .flagship {
      grid-column: 1 / -1;
    }

    .flagship__grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }

    .caps {
      padding-top: 0;
      border-top: 0;
      border-left: 1px solid var(--ed-line);
      padding-left: 1.5rem;
    }

    .spec {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
