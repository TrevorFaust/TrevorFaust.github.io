<p class="hunt-live" data-hunt-live aria-live="polite"></p>

<script>
  type Clue = 1 | 2 | 3 | 4;

  const FOUND_KEY = "tf-hunt-found";
  const root = document.documentElement;
  const motion = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const live = document.querySelector<HTMLElement>("[data-hunt-live]");

  const clues: Record<Clue, [string, string]> = {
    1: ["Clue 1 of 4", "Lock on. Take a shot on the target to the right."],
    2: ["Clue 2 of 4", "Target down, now find what I do when I go off the clock."],
    3: ["Clue 3 of 4", "Time's up. Catch a ✦ as it rolls through the ribbon."],
    4: ["Clue 4 of 4 · Your fortune", "A Classified file just landed in my contact cabinet."],
  };

  const CLOCK_SVG = `<svg viewBox="0 0 64 72" aria-hidden="true">
    <circle cx="14" cy="12" r="8" fill="#1a1c18" />
    <circle cx="50" cy="12" r="8" fill="#1a1c18" />
    <path d="M17 62 L11 70 M47 62 L53 70" stroke="#1a1c18" stroke-width="4" stroke-linecap="round" />
    <circle cx="32" cy="40" r="27" fill="#f6f2e9" stroke="#1a1c18" stroke-width="4" />
    <path d="M32 17v5M32 58v5M9 40h5M50 40h5" stroke="#3d6f5f" stroke-width="3" stroke-linecap="round" />
    <line class="hunt-clock__hour" x1="32" y1="40" x2="32" y2="27" stroke="#1a1c18" stroke-width="3.5" stroke-linecap="round" />
    <line class="hunt-clock__minute" x1="32" y1="40" x2="45" y2="40" stroke="#3d6f5f" stroke-width="2.5" stroke-linecap="round" />
    <circle cx="32" cy="40" r="3" fill="#1a1c18" />
  </svg>`;

  const STAR_SVG = `<svg viewBox="0 0 100 100" aria-hidden="true">
    <path d="M50 0C54 34 66 46 100 50C66 54 54 66 50 100C46 66 34 54 0 50C34 46 46 34 50 0Z" />
  </svg>`;

  const CLOCK_W = 72;
  const CLOCK_H = 81;

  let step = 0;
  let pieces: HTMLElement[] = [];
  let placers: (() => void)[] = [];
  let takenStar: HTMLElement | null = null;
  let statusNote: HTMLElement | null = null;

  const px = (n: number) => `${n}px`;
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const play = (el: Element, frames: Keyframe[], options: KeyframeAnimationOptions) =>
    el.animate(frames, { fill: "both", ...options }).finished.catch(() => undefined);

  const relative = (el: Element, host: Element) => {
    const a = el.getBoundingClientRect();
    const h = host.getBoundingClientRect();
    const x = a.left - h.left;
    const y = a.top - h.top;
    return { x, y, w: a.width, h: a.height, cx: x + a.width / 2, cy: y + a.height / 2 };
  };

  const setStep = (next: number) => {
    step = next;
    root.dataset.hunt = String(next);
    window.dispatchEvent(new CustomEvent("hunt:step", { detail: next }));
  };

  const announce = (clue: Clue, text = clues[clue][1]) => {
    if (live) live.textContent = `${clues[clue][0]}. ${text}`;
  };

  const makeNote = (clue: Clue, variant: string, text = clues[clue][1]) => {
    const [label] = clues[clue];
    const note = document.createElement("div");
    note.className = `hunt-note hunt-note--${variant}`;
    const labelEl = document.createElement("span");
    labelEl.className = "hunt-note__label";
    labelEl.textContent = label;
    const textEl = document.createElement("span");
    textEl.className = "hunt-note__text";
    textEl.textContent = text;
    note.append(labelEl, textEl);
    pieces.push(note);
    announce(clue, text);
    return note;
  };

  const nudge = (el: Element) =>
    el.animate(
      [
        { rotate: "0deg", translate: "0 0" },
        { rotate: "-2deg", translate: "-6px 0" },
        { rotate: "1.5deg", translate: "5px 0" },
        { rotate: "-0.5deg", translate: "-2px 0" },
        { rotate: "0deg", translate: "0 0" },
      ],
      { duration: 450, easing: "ease-out" },
    );

  type Point = { x: number; y: number };

  const SPARK_COLORS = ["#e0a526", "#f0c05a", "#e0663f", "#2f9c72", "#3d6f5f"];
  const easeInOut = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - (-2 * k + 2) ** 3 / 2);

  /* Points that trace the clue's letters, in page coordinates, so sparks can settle onto them */
  const letterPoints = (note: HTMLElement): Point[] => {
    const textEl = note.querySelector<HTMLElement>(".hunt-note__text");
    const node = textEl?.firstChild;
    if (!textEl || !(node instanceof Text)) return [];
    const box = textEl.getBoundingClientRect();
    const canvas = document.createElement("canvas");
    canvas.width = Math.ceil(box.width);
    canvas.height = Math.ceil(box.height);
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    if (!ctx || !canvas.width || !canvas.height) return [];
    const style = getComputedStyle(textEl);
    ctx.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    ctx.textBaseline = "alphabetic";

    const range = document.createRange();
    const text = node.textContent ?? "";
    for (const word of text.matchAll(/\S+/g)) {
      range.setStart(node, word.index ?? 0);
      range.setEnd(node, (word.index ?? 0) + word[0].length);
      const r = range.getBoundingClientRect();
      const metrics = ctx.measureText(word[0]);
      const ascent = metrics.fontBoundingBoxAscent ?? r.height * 0.8;
      const descent = metrics.fontBoundingBoxDescent ?? r.height * 0.2;
      const baseline = r.top + (r.height - ascent - descent) / 2 + ascent;
      ctx.fillText(word[0], r.left - box.left, baseline - box.top);
    }

    const { data } = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const points: Point[] = [];
    for (let y = 0; y < canvas.height; y += 2) {
      for (let x = 0; x < canvas.width; x += 2) {
        if (data[(y * canvas.width + x) * 4 + 3] > 140) points.push({ x: box.left + x, y: box.top + y });
      }
    }
    for (let i = points.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [points[i], points[j]] = [points[j], points[i]];
    }
    return points.slice(0, 1200);
  };

  /* A rocket leaves the dot, bursts, and the sparks drift down into the clue's letters */
  const launchFirework = (host: HTMLElement, from: Point, targets: Point[], onWritten: () => void) =>
    new Promise<void>((resolve) => {
      const rect = host.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const canvas = document.createElement("canvas");
      canvas.className = "hunt-fireworks";
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      host.append(canvas);
      const ctx = canvas.getContext("2d");
      if (!ctx) {
        canvas.remove();
        onWritten();
        resolve();
        return;
      }
      ctx.scale(dpr, dpr);

      const ROCKET = 700;
      const BURST = 650;
      const FORM = 1100;
      const SETTLE = 700;
      const start = { x: from.x - rect.left, y: from.y - rect.top };
      const apex = { x: Math.min(rect.width - 80, start.x + 180), y: Math.max(80, start.y - 300) };

      type Spark = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        color: string;
        size: number;
        delay: number;
        target?: Point;
        from?: Point;
      };
      const trail: (Spark & { life: number })[] = [];
      let sparks: Spark[] = [];
      let exploded = false;
      let written = false;
      const t0 = performance.now();
      let last = t0;

      const dot = (x: number, y: number, size: number, color: string, alpha: number, glow = 2.8) => {
        ctx.fillStyle = color;
        ctx.globalAlpha = alpha * 0.22;
        ctx.beginPath();
        ctx.arc(x, y, size * glow, 0, Math.PI * 2);
        ctx.fill();
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(x, y, size, 0, Math.PI * 2);
        ctx.fill();
      };

      const explode = () => {
        const make = (target?: Point): Spark => {
          const angle = Math.random() * Math.PI * 2;
          const speed = 1.5 + Math.random() * 5;
          return {
            x: apex.x,
            y: apex.y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            color: SPARK_COLORS[Math.floor(Math.random() * SPARK_COLORS.length)],
            size: target ? 0.8 + Math.random() * 0.45 : 1.4 + Math.random() * 1.2,
            delay: Math.random() * 220,
            target: target && { x: target.x - rect.left, y: target.y - rect.top },
          };
        };
        sparks = [...targets.map((target) => make(target)), ...Array.from({ length: 90 }, () => make())];
      };

      const frame = (now: number) => {
        const t = now - t0;
        const dt = Math.min(2.5, (now - last) / 16.67);
        last = now;

        ctx.globalCompositeOperation = "destination-out";
        ctx.globalAlpha = 1;
        ctx.fillStyle = `rgba(0, 0, 0, ${t < ROCKET + BURST ? 0.26 : 0.42})`;
        ctx.fillRect(0, 0, rect.width, rect.height);
        ctx.globalCompositeOperation = "source-over";

        if (t < ROCKET) {
          const k = 1 - (1 - t / ROCKET) ** 2;
          const x = start.x + (apex.x - start.x) * k + Math.sin(t / 45) * 1.5;
          const y = start.y + (apex.y - start.y) * k;
          dot(x, y, 3, "#e0a526", 1);
          for (let i = 0; i < 3; i++) {
            trail.push({
              x,
              y,
              vx: (Math.random() - 0.5) * 0.8,
              vy: 0.6 + Math.random() * 0.8,
              color: SPARK_COLORS[i % 3],
              size: 1 + Math.random(),
              delay: 0,
              life: 1,
            });
          }
        } else if (!exploded) {
          exploded = true;
          explode();
        }

        for (const s of trail) {
          if (s.life <= 0) continue;
          s.x += s.vx * dt;
          s.y += s.vy * dt;
          s.vy += 0.05 * dt;
          s.life -= 0.035 * dt;
          dot(s.x, s.y, s.size, s.color, Math.max(0, s.life));
        }

        if (exploded) {
          const te = t - ROCKET;
          if (te < 220) {
            const flash = 1 - te / 220;
            dot(apex.x, apex.y, 6 + te * 0.12, "#f7d98b", flash);
          }

          const settle = Math.max(0, te - BURST - FORM) / SETTLE;
          for (const s of sparks) {
            const forming = s.target && te > BURST + s.delay;
            if (!forming) {
              const drag = 0.955 ** dt;
              s.vx *= drag;
              s.vy = s.vy * drag + 0.055 * dt;
              s.x += s.vx * dt;
              s.y += s.vy * dt;
            } else if (s.target) {
              s.from ??= { x: s.x, y: s.y };
              const k = easeInOut(Math.min(1, (te - BURST - s.delay) / (FORM - 220)));
              const sway = (1 - k) * 4 * Math.sin(te / 90 + s.delay);
              s.x = s.from.x + (s.target.x - s.from.x) * k + sway;
              s.y = s.from.y + (s.target.y - s.from.y) * k;
            }
            const alpha = s.target
              ? (1 - settle) * (0.75 + Math.random() * 0.25)
              : Math.max(0, 1 - te / (BURST + 450));
            if (alpha > 0) dot(s.x, s.y, s.size, s.color, alpha, s.target ? 2 : 2.8);
          }

          if (!written && te > BURST + FORM * 0.8) {
            written = true;
            onWritten();
          }
          if (te > BURST + FORM + SETTLE) {
            canvas.remove();
            resolve();
            return;
          }
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    });

  /* Clue 1: a firework shoots out of the green dot and writes the clue under it */
  const popFromStatus = async (status: HTMLElement) => {
    const host = status.parentElement;
    const hero = status.closest<HTMLElement>("[data-hero]");
    if (!host || !hero) return;
    const wide = window.matchMedia("(min-width: 960px)").matches;
    statusNote = makeNote(
      1,
      "status",
      wide ? clues[1][1] : "Lock on. Take a shot on the target up top.",
    );
    host.append(statusNote);
    if (!motion) return;

    const note = statusNote;
    note.style.opacity = "0";
    await document.fonts?.ready;
    const dotEl = status.querySelector(".hero__status-dot") ?? status;
    const d = dotEl.getBoundingClientRect();
    await launchFirework(hero, { x: d.left + d.width / 2, y: d.top + d.height / 2 }, letterPoints(note), () =>
      play(
        note,
        [
          { opacity: 0, filter: "blur(3px)" },
          { opacity: 1, filter: "blur(0px)" },
        ],
        { duration: 700, easing: "ease-out" },
      ),
    );
  };

  /* Only a click on my head or neck counts. Zones are fractions of the cutout image; the pixel
     must be opaque and redder than it is green, which keeps out the transparent sky and the hoodie. */
  let skinPixels: { data: Uint8ClampedArray; width: number; height: number } | null = null;

  const readPixels = (img: HTMLImageElement) => {
    if (skinPixels?.width === img.naturalWidth) return skinPixels;
    const canvas = document.createElement("canvas");
    canvas.width = img.naturalWidth;
    canvas.height = img.naturalHeight;
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    if (!ctx) return null;
    ctx.drawImage(img, 0, 0);
    skinPixels = { data: ctx.getImageData(0, 0, canvas.width, canvas.height).data, width: canvas.width, height: canvas.height };
    return skinPixels;
  };

  const hitsSkin = (reticle: HTMLElement, event: MouseEvent) => {
    if (event.clientX === 0 && event.clientY === 0) return true;
    const img = reticle.parentElement?.querySelector<HTMLImageElement>("img");
    if (!img?.naturalWidth) return true;
    const box = img.getBoundingClientRect();
    const scale = Math.max(box.width / img.naturalWidth, box.height / img.naturalHeight);
    const drawnW = img.naturalWidth * scale;
    const drawnH = img.naturalHeight * scale;
    const u = (event.clientX - box.left - (box.width - drawnW) / 2) / drawnW;
    const v = (event.clientY - box.top - (box.height - drawnH) / 2) / drawnH;

    const inHead = ((u - 0.573) / 0.125) ** 2 + ((v - 0.244) / 0.084) ** 2 <= 1;
    const inNeck = u >= 0.48 && u <= 0.635 && v >= 0.29 && v <= 0.355;
    if (!inHead && !inNeck) return false;

    try {
      const pixels = readPixels(img);
      if (!pixels) return true;
      const x = Math.min(pixels.width - 1, Math.max(0, Math.round(u * pixels.width)));
      const y = Math.min(pixels.height - 1, Math.max(0, Math.round(v * pixels.height)));
      const i = (y * pixels.width + x) * 4;
      const [r, g, , a] = pixels.data.slice(i, i + 4);
      return a > 128 && r > g;
    } catch {
      return inHead;
    }
  };

  const miss = (reticle: HTMLElement, event: MouseEvent) => {
    const figure = reticle.parentElement;
    if (!figure) return;
    const f = figure.getBoundingClientRect();
    const puff = document.createElement("i");
    puff.className = "hunt-miss";
    puff.style.left = px(event.clientX - f.left);
    puff.style.top = px(event.clientY - f.top);
    figure.append(puff);
    play(
      puff,
      [
        { opacity: 0.9, transform: "scale(0.4)" },
        { opacity: 0, transform: "scale(1.8)" },
      ],
      { duration: 500, easing: "ease-out" },
    ).then(() => puff.remove());
  };

  /* Clue 2: a shot lands on my face, leaves a dot, and the next card rises from the hit to above my head */
  const shoot = async (reticle: HTMLElement, event: MouseEvent) => {
    const figure = reticle.parentElement;
    if (!figure) return;
    const f = figure.getBoundingClientRect();
    const r = relative(reticle, figure);
    const hasPoint = event.clientX !== 0 || event.clientY !== 0;
    const hitX = hasPoint ? event.clientX - f.left : r.cx;
    const hitY = hasPoint ? event.clientY - f.top : r.cy;
    const inked = document.fonts.load("1rem Nosifer").catch(() => []);

    const dot = document.createElement("i");
    dot.className = "hunt-dot";
    dot.style.left = px(hitX);
    dot.style.top = px(hitY);
    figure.append(dot);
    pieces.push(dot);
    if (motion) {
      play(dot, [{ transform: "scale(2.2)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], {
        duration: 260,
        easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
      });
    }

    // The figure's mask would clip anything outside it, so the clue hangs off the stage instead
    const stage = figure.parentElement ?? figure;
    const note = makeNote(2, "target");
    const place = () => {
      const box = relative(reticle, stage);
      const s = stage.getBoundingClientRect();
      const navH = document.querySelector("header")?.getBoundingClientRect().height ?? 0;
      const maxLeft = document.documentElement.clientWidth - s.left - note.offsetWidth - 12;
      const left = Math.max(12 - s.left, Math.min(maxLeft, box.cx - note.offsetWidth / 2));
      note.style.left = px(left);
      note.style.top = px(Math.max(navH + 4 - (s.top + window.scrollY), box.y - note.offsetHeight + 10));
    };

    if (!motion) {
      await inked;
      stage.append(note);
      place();
      placers.push(place);
      return;
    }

    const shot = document.createElement("div");
    shot.className = "hunt-shot";
    shot.style.left = px(hitX);
    shot.style.top = px(hitY);
    shot.innerHTML = '<i class="hunt-shot__flash"></i><i class="hunt-shot__ring"></i><i class="hunt-shot__mark"></i>';
    figure.append(shot);
    setTimeout(() => shot.remove(), 1000);

    reticle.animate([{ scale: "1" }, { scale: "0.8" }, { scale: "1.06" }, { scale: "1" }], {
      duration: 420,
      easing: "ease-out",
    });
    figure.parentElement?.animate(
      [
        { translate: "0 0" },
        { translate: "-7px 3px" },
        { translate: "6px -4px" },
        { translate: "-3px 2px" },
        { translate: "0 0" },
      ],
      { duration: 320, easing: "ease-out" },
    );

    await Promise.all([wait(420), inked]);
    stage.append(note);
    place();
    placers.push(place);
    const hit = relative(dot, stage);
    const dx = hit.cx - (parseFloat(note.style.left) + note.offsetWidth / 2);
    const dy = hit.cy - (parseFloat(note.style.top) + note.offsetHeight / 2);
    await play(
      note,
      [
        { opacity: 0, transform: `translate(${dx}px, ${dy}px) scale(0.3)`, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)" },
        { opacity: 1, transform: `translate(${dx}px, ${dy - 14}px) scale(1)`, offset: 0.28 },
        { opacity: 1, transform: `translate(${dx}px, ${dy - 14}px) scale(1)`, offset: 0.42, easing: "cubic-bezier(0.65, 0, 0.35, 1)" },
        { opacity: 1, transform: "none" },
      ],
      { duration: 1400 },
    );
  };

  /* Clue 3: an alarm clock pops up, falls, shatters, and the pieces become the next card */
  const breakClock = async (tag: HTMLElement) => {
    const media = tag.closest<HTMLElement>(".about__media");
    if (!media) return;
    const note = makeNote(3, "clock");
    media.append(note);
    if (!motion) return;

    note.style.opacity = "0";
    const t = relative(tag, media);
    const n = relative(note, media);
    const baseX = t.cx - CLOCK_W / 2;
    const baseY = t.cy - CLOCK_H / 2;
    const floor = n.cy - t.cy;
    const peak = Math.min(-150, floor - 110);

    const clock = document.createElement("div");
    clock.className = "hunt-clock is-ringing";
    clock.innerHTML = CLOCK_SVG;
    clock.style.left = px(baseX);
    clock.style.top = px(baseY);
    media.append(clock);

    await play(
      clock,
      [
        { opacity: 0, transform: "translateY(0) scale(0.2)" },
        { opacity: 1, transform: `translateY(${peak}px) scale(1)` },
      ],
      { duration: 560, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)" },
    );
    await play(
      clock,
      [0, -14, 12, -10, 8, -4, 0].map((deg) => ({ transform: `translateY(${peak}px) rotate(${deg}deg)` })),
      { duration: 560 },
    );
    await play(
      clock,
      [
        { transform: `translateY(${peak}px) rotate(0deg)` },
        { transform: `translateY(${floor}px) rotate(24deg)` },
      ],
      { duration: 420, easing: "cubic-bezier(0.55, 0, 1, 0.45)" },
    );
    clock.remove();

    const angles = [0, 50, 100, 150, 200, 250, 305, 360];
    const edge = (deg: number) => {
      const rad = (deg * Math.PI) / 180;
      return `${50 + 90 * Math.cos(rad)}% ${55.5 + 90 * Math.sin(rad)}%`;
    };
    const shards = angles.slice(0, -1).map((start, i) => {
      const end = angles[i + 1];
      const mid = (((start + end) / 2) * Math.PI) / 180;
      const shard = document.createElement("div");
      shard.className = "hunt-clock hunt-clock--shard";
      shard.innerHTML = CLOCK_SVG;
      shard.style.left = px(baseX);
      shard.style.top = px(baseY + floor);
      shard.style.clipPath = `polygon(50% 55.5%, ${edge(start)}, ${edge((start + end) / 2)}, ${edge(end)})`;
      media.append(shard);
      const dist = 55 + Math.random() * 50;
      return {
        shard,
        i,
        bx: Math.cos(mid) * dist,
        by: Math.sin(mid) * dist + 26,
        spin: 24 + (Math.random() - 0.5) * 300,
      };
    });

    await Promise.all(
      shards.map(({ shard, bx, by, spin }) =>
        play(
          shard,
          [
            { transform: "translate(0, 0) rotate(24deg)" },
            { transform: `translate(${bx}px, ${by}px) rotate(${spin}deg)` },
          ],
          { duration: 620, easing: "cubic-bezier(0.2, 0.8, 0.3, 1)" },
        ),
      ),
    );

    play(
      note,
      [
        { opacity: 0, filter: "blur(8px)", transform: "scale(0.94)" },
        { opacity: 1, filter: "blur(0px)", transform: "none" },
      ],
      { duration: 520, delay: 240, easing: "ease-out" },
    );
    await Promise.all(
      shards.map(({ shard, i, bx, by, spin }) => {
        const tx = n.x + ((i + 0.5) / shards.length) * n.w - (baseX + CLOCK_W / 2);
        const ty = n.cy - (baseY + floor + CLOCK_H / 2);
        return play(
          shard,
          [
            { opacity: 1, transform: `translate(${bx}px, ${by}px) rotate(${spin}deg) scale(1)` },
            { opacity: 0, transform: `translate(${tx}px, ${ty}px) rotate(0deg) scale(0.15)` },
          ],
          { duration: 560, delay: i * 35, easing: "cubic-bezier(0.55, 0, 0.45, 1)" },
        );
      }),
    );
    shards.forEach(({ shard }) => shard.remove());
  };

  /* Clue 4: the star drops out of the ribbon and cracks open like a fortune cookie */
  const crackStar = async (star: HTMLElement) => {
    const ribbon = star.closest<HTMLElement>("[data-ribbon]");
    if (!ribbon) return;
    const s = relative(star, ribbon);
    star.classList.add("hunt-star-taken");
    takenStar = star;

    const [label, text] = clues[4];
    const fortune = document.createElement("div");
    fortune.className = "hunt-fortune";
    fortune.innerHTML = `<div class="hunt-fortune__slip"><span class="hunt-note__label"></span><span class="hunt-fortune__text"></span></div>
      <span class="hunt-fortune__half hunt-fortune__half--l">${STAR_SVG}</span>
      <span class="hunt-fortune__half hunt-fortune__half--r">${STAR_SVG}</span>`;
    fortune.querySelector(".hunt-note__label")!.textContent = label;
    fortune.querySelector(".hunt-fortune__text")!.textContent = text;
    pieces.push(fortune);
    announce(4);
    ribbon.append(fortune);

    const slip = fortune.querySelector<HTMLElement>(".hunt-fortune__slip")!;
    const [left, right] = fortune.querySelectorAll<HTMLElement>(".hunt-fortune__half");
    const place = () => {
      const half = fortune.offsetWidth / 2 + 56;
      fortune.style.left = px(Math.max(half, Math.min(ribbon.clientWidth - half, s.cx)));
    };
    place();
    placers.push(place);

    const spread = slip.offsetWidth / 2 + 2;
    const openLeft = `translate(${-spread}px, 4px) rotate(-28deg)`;
    const openRight = `translate(${spread}px, 4px) rotate(28deg)`;

    if (!motion) {
      left.style.transform = openLeft;
      right.style.transform = openRight;
      return;
    }

    slip.style.opacity = "0";
    const f = relative(left, ribbon);
    const dx = s.cx - f.cx;
    const dy = s.cy - f.cy;
    const fall: Keyframe[] = [
      { transform: `translate(${dx}px, ${dy}px) scale(0.5) rotate(0deg)`, easing: "cubic-bezier(0.2, 0.6, 0.4, 1)" },
      { transform: `translate(${dx * 0.7}px, ${dy - 34}px) scale(0.75) rotate(120deg)`, offset: 0.3, easing: "cubic-bezier(0.5, 0, 0.9, 0.5)" },
      { transform: "translate(0px, 0px) scale(1) rotate(360deg)", offset: 0.8, easing: "ease-out" },
      { transform: "translate(0px, -9px) scale(1.06, 0.94) rotate(360deg)", offset: 0.9, easing: "ease-in" },
      { transform: "translate(0px, 0px) scale(1) rotate(360deg)" },
    ];
    await Promise.all([left, right].map((half) => play(half, fall, { duration: 1000 })));

    const shake = [0, 9, -8, 6, -3, 0].map((deg) => ({ transform: `rotate(${deg}deg)` }));
    await Promise.all([left, right].map((half) => play(half, shake, { duration: 380 })));

    for (let i = 0; i < 7; i++) {
      const crumb = document.createElement("i");
      crumb.className = "hunt-crumb";
      fortune.append(crumb);
      const angle = -Math.PI / 2 + (i - 3) * 0.45;
      const dist = 26 + Math.random() * 22;
      play(
        crumb,
        [
          { opacity: 1, transform: "translate(0, 0) scale(1)" },
          { opacity: 0, transform: `translate(${Math.cos(angle) * dist}px, ${Math.sin(angle) * dist + 30}px) scale(0.4)` },
        ],
        { duration: 700, easing: "cubic-bezier(0.2, 0.8, 0.4, 1)" },
      ).then(() => crumb.remove());
    }

    const open = { duration: 760, easing: "cubic-bezier(0.22, 1, 0.36, 1)" };
    await Promise.all([
      play(left, [{ transform: "none" }, { transform: openLeft }], open),
      play(right, [{ transform: "none" }, { transform: openRight }], open),
      play(
        slip,
        [
          { opacity: 0, transform: "scaleX(0.05)" },
          { opacity: 1, transform: "scaleX(1)" },
        ],
        { ...open, delay: 60 },
      ),
    ]);
  };

  /* Opening the Classified card clears every clue so the hunt can be played again */
  const finish = async () => {
    try {
      localStorage.setItem(FOUND_KEY, "1");
    } catch {
      /* storage can be blocked; the hunt still resets for this visit */
    }
    const leaving = pieces;
    const star = takenStar;
    pieces = [];
    placers = [];
    statusNote = null;
    takenStar = null;
    setStep(0);
    if (live) live.textContent = "Hunt complete. Click the status line again to play it over.";

    await wait(motion ? 900 : 0);
    await Promise.all(
      leaving.map((el, i) =>
        play(
          el,
          [
            { opacity: 1, filter: "blur(0px)" },
            { opacity: 0, filter: "blur(6px)" },
          ],
          { duration: motion ? 700 : 1, delay: motion ? i * 140 : 0, easing: "ease-in" },
        ).then(() => el.remove()),
      ),
    );
    star?.classList.remove("hunt-star-taken");
  };

  document.addEventListener("click", (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>("[data-hunt]");
    if (!target) return;

    switch (target.dataset.hunt) {
      case "status":
        if (step === 0) {
          setStep(1);
          popFromStatus(target);
        } else if (statusNote) {
          nudge(statusNote);
        }
        break;
      case "reticle":
        if (step !== 1) break;
        if (!hitsSkin(target, event)) {
          miss(target, event);
          break;
        }
        setStep(2);
        shoot(target, event);
        break;
      case "clock":
        if (step === 2) {
          setStep(3);
          breakClock(target);
        }
        break;
      case "star":
        if (step === 3) {
          setStep(4);
          crackStar(target);
        }
        break;
    }
  });

  window.addEventListener("hunt:found", () => {
    if (step === 4) finish();
  });

  window.addEventListener("resize", () => placers.forEach((place) => place()));

  document.querySelector("[data-hunt-hint]")?.addEventListener("click", () => {
    const status = document.querySelector<HTMLElement>('[data-hunt="status"]');
    if (!status) return;
    status.scrollIntoView({ behavior: motion ? "smooth" : "auto", block: "center" });
    setTimeout(
      () =>
        status.animate(
          [
            { scale: "1", color: "#4a4e45" },
            { scale: "1.12", color: "#3d6f5f" },
            { scale: "1", color: "#4a4e45" },
          ],
          { duration: 650, iterations: 2, easing: "ease-in-out" },
        ),
      motion ? 900 : 0,
    );
  });

  setStep(0);
</script>

