---
import { site } from "../data/site";

const prettyUrl = (url: string) =>
  url.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");

const links = [
  { kind: "Email", value: site.email, href: `mailto:${site.email}`, external: false },
  { kind: "LinkedIn", value: prettyUrl(site.links.linkedin), href: site.links.linkedin, external: true },
  { kind: "Substack", value: prettyUrl(site.links.substack), href: site.links.substack, external: true },
  { kind: "GitHub", value: prettyUrl(site.links.github), href: site.links.github, external: true },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="shell">
    <p class="section-label reveal">Contact</p>
    <h2 id="contact-title" class="display contact__title reveal reveal-delay-1">
      Find me here. <em>Pick a link.</em>
    </h2>
    <p class="lead reveal reveal-delay-2">
      Reach out about data analytics roles in sports, technology, or energy and
      sustainability, or to talk shop about building things people use.
    </p>

    <ul class="contact__links">
      {
        links.map((link, index) => (
          <li class={`reveal reveal-delay-${Math.min(index, 3)}`}>
            <a
              class="contact__row"
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              data-spotlight
            >
              <span class="contact__kind">{link.kind}</span>
              <span class="contact__value">{link.value}</span>
              <span class="contact__arrow" aria-hidden="true">
                {link.external ? "↗" : "→"}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="shell footer__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>Built with Astro · Deployed on GitHub Pages</p>
    <p>{site.location} · {site.coordinates}</p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLElement>(".contact__row[data-spotlight]").forEach((row) => {
    row.addEventListener("pointermove", (event) => {
      const rect = row.getBoundingClientRect();
      row.style.setProperty("--x", `${event.clientX - rect.left}px`);
      row.style.setProperty("--y", `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: clip;
  }

  .contact::before {
    content: "";
    position: absolute;
    right: -15%;
    bottom: -30%;
    width: 60vw;
    height: 60vw;
    max-width: 52rem;
    max-height: 52rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.12), transparent 62%);
    pointer-events: none;
  }

  .contact__title {
    font-size: clamp(3rem, 9vw, 7.5rem);
    max-width: 10ch;
  }

  .contact__links {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .contact__row {
    --x: 50%;
    --y: 50%;
    position: relative;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: clamp(1.25rem, 2.6vw, 1.75rem) clamp(0.25rem, 1.5vw, 1rem);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    isolation: isolate;
  }

  .contact__row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(380px circle at var(--x) var(--y), rgba(var(--glow-rgb), 0.85), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .contact__row::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--grad-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .contact__row:hover::before {
    opacity: 1;
  }

  .contact__row:hover::after {
    transform: scaleX(1);
  }

  .contact__kind {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .contact__value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    overflow-wrap: anywhere;
    transition: transform 0.5s var(--ease);
  }

  .contact__row:hover .contact__value {
    transform: translateX(0.4rem);
    font-style: italic;
  }

  .contact__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.5s var(--ease);
  }

  .contact__row:hover .contact__arrow {
    background: var(--ink);
    border-color: var(--ink);
    color: #f4f1ea;
    transform: rotate(-8deg) scale(1.05);
  }

  @media (max-width: 640px) {
    .contact__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .contact__kind {
      grid-column: 1 / -1;
    }
  }

  .footer {
    position: relative;
    z-index: 1;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer p {
    margin: 0;
  }
</style>
