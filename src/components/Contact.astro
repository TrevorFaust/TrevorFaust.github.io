---
import { site } from "../data/site";
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="shell contact__panel reveal">
    <p class="section-label">Contact</p>
    <h2 id="contact-title" class="display contact__title">
      One link.<br />Everything here.
    </h2>
    <p class="lead">
      Reach out for data analytics roles in sports or technology — or just to talk shop about
      building things people use.
    </p>

    <div class="contact__links">
      <a class="contact__card" href={`mailto:${site.email}`}>
        <span class="contact__kind">Email</span>
        <span class="contact__value">{site.email}</span>
      </a>
      <a
        class="contact__card"
        href={site.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact__kind">LinkedIn</span>
        <span class="contact__value">trevor-faust-000t</span>
      </a>
      <a
        class="contact__card"
        href={site.links.substack}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact__kind">Substack</span>
        <span class="contact__value">@trevorfaust</span>
      </a>
      <a
        class="contact__card"
        href={site.links.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact__kind">GitHub</span>
        <span class="contact__value">TrevorFaust</span>
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="shell footer__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>{site.location}</p>
  </div>
</footer>

<style>
  .contact__panel {
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: calc(var(--radius) + 0.5rem);
    background:
      linear-gradient(145deg, rgba(31, 79, 69, 0.12), transparent 40%),
      var(--bg-elevated);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .contact__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .contact__links {
    display: grid;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 720px) {
    .contact__links {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact__card {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: rgba(255, 252, 247, 0.55);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .contact__card:hover {
    transform: translateY(-2px);
    border-color: rgba(31, 79, 69, 0.3);
    background: rgba(255, 252, 247, 0.9);
  }

  .contact__kind {
    color: var(--ink-faint);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__value {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .footer {
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .footer p {
    margin: 0;
  }
</style>
