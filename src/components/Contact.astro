---
import { site } from "../data/site";

const prettyUrl = (url: string) =>
  url.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");

const contacts = [
  {
    kind: "Email",
    value: site.email,
    href: `mailto:${site.email}`,
    openLabel: "Open email",
    external: false,
  },
  {
    kind: "LinkedIn",
    value: prettyUrl(site.links.linkedin),
    href: site.links.linkedin,
    openLabel: "Open LinkedIn profile",
    external: true,
  },
  {
    kind: "Substack",
    value: prettyUrl(site.links.substack),
    href: site.links.substack,
    openLabel: "Open Substack",
    external: true,
  },
  {
    kind: "GitHub",
    value: prettyUrl(site.links.github),
    href: site.links.github,
    openLabel: "Open GitHub profile",
    external: true,
  },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="shell contact__panel reveal">
    <p class="section-label">Contact</p>
    <h2 id="contact-title" class="display contact__title">
      Find me here.<br />Pick a link.
    </h2>
    <p class="lead">
      Reach out about data analytics roles in sports, technology, or energy and
      sustainability, or to talk shop about building things people use.
    </p>

    <div class="contact__links">
      {
        contacts.map((contact) => (
          <article class="contact__card">
            <div class="contact__top">
              <p class="contact__kind">{contact.kind}</p>
              <a
                class="contact__open"
                href={contact.href}
                aria-label={contact.openLabel}
                target={contact.external ? "_blank" : undefined}
                rel={contact.external ? "noopener noreferrer" : undefined}
              >
                Open
                <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="contact__value">{contact.value}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<footer class="footer">
  <div class="shell footer__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>{site.location}</p>
  </div>
</footer>

<style>
  .contact__panel {
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: calc(var(--radius) + 0.5rem);
    background:
      linear-gradient(145deg, rgba(var(--accent-rgb), 0.12), transparent 40%),
      var(--bg-elevated);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .contact__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  .contact__links {
    display: grid;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  @media (min-width: 720px) {
    .contact__links {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact__card {
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: rgba(255, 252, 247, 0.55);
    border: 1px solid var(--line);
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .contact__card:hover {
    border-color: rgba(var(--accent-rgb), 0.3);
    background: rgba(255, 252, 247, 0.9);
  }

  .contact__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .contact__kind {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    padding: 0 0.15rem;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .contact__open:hover {
    color: var(--accent-soft);
  }

  .contact__value {
    margin: 0;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.4;
    overflow-wrap: break-word;
    cursor: text;
    user-select: all;
    -webkit-user-select: all;
  }

  .footer {
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .footer p {
    margin: 0;
  }
</style>
