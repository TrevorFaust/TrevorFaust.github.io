---
import { site } from "../data/site";

const prettyUrl = (url: string) =>
  url.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");

const links = [
  { kind: "LinkedIn", value: prettyUrl(site.links.linkedin), href: site.links.linkedin },
  { kind: "Substack", value: prettyUrl(site.links.substack), href: site.links.substack },
  { kind: "GitHub", value: prettyUrl(site.links.github), href: site.links.github },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="shell">
    <p class="section-label reveal"><span class="section-label__num">03</span>Contact</p>
    <h2 id="contact-title" class="display contact__title reveal reveal-delay-1">
      Find me here. <em>Pick a link.</em>
    </h2>
    <p class="lead reveal reveal-delay-2">
      Reach out about data analytics roles in sports, technology, or energy and
      sustainability, or to talk shop about building things people use.
    </p>

    <a class="contact__email reveal reveal-delay-3" href={`mailto:${site.email}`}>
      <span class="contact__email-kind">Email</span>
      <span class="contact__email-value">{site.email}</span>
      <span class="contact__email-arrow" aria-hidden="true">→</span>
    </a>

    <ul class="contact__links">
      {
        links.map((link) => (
          <li class="reveal">
            <a class="contact__row" href={link.href} target="_blank" rel="noopener noreferrer">
              <span class="contact__kind">{link.kind}</span>
              <span class="contact__value">{link.value}</span>
              <span class="contact__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="shell footer__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p class="footer__mid">Built with Astro · Deployed on GitHub Pages</p>
    <p>{site.location} · {site.coordinates}</p>
  </div>
</footer>

<style>
  .contact {
    position: relative;
    overflow: clip;
  }

  .contact::before {
    content: "";
    position: absolute;
    right: -15%;
    bottom: -30%;
    width: 60vw;
    height: 60vw;
    max-width: 52rem;
    max-height: 52rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--sun-rgb), 0.12), transparent 62%);
    pointer-events: none;
  }

  .contact__title {
    font-size: clamp(3rem, 9vw, 7.5rem);
    max-width: 10ch;
  }

  .contact__email {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "kind arrow"
      "value arrow";
    align-items: center;
    gap: 0.35rem 1.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-block: 1px solid var(--line-strong);
    text-decoration: none;
  }

  .contact__email-kind {
    grid-area: kind;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .contact__email-value {
    grid-area: value;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 6.2vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    background: linear-gradient(90deg, var(--ink) 0%, var(--ink) 50%, #ffb48c 50%, #ff8466 100%);
    background-size: 200% 100%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: background-position 0.8s var(--ease);
  }

  .contact__email:hover .contact__email-value {
    background-position: 100% 0;
  }

  .contact__email-arrow {
    grid-area: arrow;
    display: grid;
    place-items: center;
    width: clamp(3rem, 6vw, 4.5rem);
    height: clamp(3rem, 6vw, 4.5rem);
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-size: 1.25rem;
    transition:
      background 0.35s ease,
      color 0.35s ease,
      transform 0.5s var(--ease);
  }

  .contact__email:hover .contact__email-arrow {
    background: var(--grad-sun);
    color: var(--bg);
    border-color: transparent;
    transform: rotate(-45deg);
  }

  .contact__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      padding 0.45s var(--ease),
      color 0.3s ease;
  }

  .contact__row:hover {
    padding-left: 0.75rem;
  }

  .contact__kind {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sun);
  }

  .contact__value {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--ink-soft);
    overflow-wrap: anywhere;
    transition: color 0.3s ease;
  }

  .contact__row:hover .contact__value {
    color: var(--ink);
  }

  .contact__arrow {
    color: var(--ink-faint);
    transition:
      transform 0.45s var(--ease),
      color 0.3s ease;
  }

  .contact__row:hover .contact__arrow {
    color: var(--sun);
    transform: translate(3px, -3px);
  }

  @media (max-width: 560px) {
    .contact__row {
      grid-template-columns: 1fr auto;
    }

    .contact__kind {
      grid-column: 1 / -1;
    }
  }

  .footer {
    position: relative;
    z-index: 1;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer p {
    margin: 0;
  }
</style>
