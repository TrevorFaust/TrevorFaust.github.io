---
import { about } from "../data/site";

const items = [...about.skills, ...about.skills];
---

<div class="marquee" aria-label="Tools I work with">
  <ul class="marquee__track">
    {
      items.map((skill, index) => (
        <li
          class={(index % about.skills.length) % 2 === 0 ? "is-upright" : undefined}
          aria-hidden={index >= about.skills.length ? "true" : undefined}
        >
          <button class="marquee__star" type="button" data-hunt="star" tabindex="-1" aria-hidden="true">
            ✦
          </button>
          {skill}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: 1.35rem;
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, rgba(255, 253, 248, 0.4), transparent 30%, transparent 70%, rgba(var(--accent-rgb), 0.07));
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee 48s linear infinite;
  }

  .marquee__track li {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-style: italic;
    line-height: 1;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .marquee__track li.is-upright {
    font-style: normal;
    color: var(--ink);
  }

  .marquee__star {
    display: grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    font-family: var(--font-body);
    font-size: 0.55em;
    font-style: normal;
    color: var(--accent);
    cursor: default;
    transition:
      transform 0.4s var(--ease-spring),
      background 0.3s ease,
      color 0.3s ease;
  }

  :global(html[data-hunt="2"]) .marquee__star {
    cursor: pointer;
    background: rgba(var(--accent-rgb), 0.14);
    animation: star-hint 1.6s var(--ease-in-out) infinite;
  }

  :global(html[data-hunt="2"]) .marquee__star:hover {
    background: var(--accent);
    color: #f4f1ea;
    animation: none;
    transform: scale(1.35) rotate(45deg);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes star-hint {
    50% {
      transform: scale(1.3);
    }
  }
</style>
