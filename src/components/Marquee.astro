---
import { about } from "../data/site";

const items = [...about.skills, ...about.skills];
---

<div class="marquee" aria-label="Tools I work with">
  <ul class="marquee__track">
    {
      items.map((skill, index) => (
        <li
          class={(index % about.skills.length) % 2 === 0 ? "is-upright" : undefined}
          aria-hidden={index >= about.skills.length ? "true" : undefined}
        >
          <span class="marquee__star" aria-hidden="true">✦</span>
          {skill}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: 1.35rem;
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, rgba(var(--sun-rgb), 0.04), transparent 30%, transparent 70%, rgba(var(--pine-rgb), 0.08));
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: marquee 48s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__track li {
    display: inline-flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-style: italic;
    line-height: 1;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .marquee__track li.is-upright {
    font-style: normal;
    color: var(--ink);
  }

  .marquee__star {
    font-family: var(--font-body);
    font-size: 0.55em;
    font-style: normal;
    color: var(--sun);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
