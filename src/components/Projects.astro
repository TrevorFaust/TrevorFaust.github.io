---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { projects } from "../data/site";
import draftdnaIcon from "../assets/mark-draftdna.png";
import scoutdnaIcon from "../assets/mark-scoutdna.webp";
import hustlehunterIcon from "../assets/mark-hustlehunter.webp";
import leaselocatorIcon from "../assets/mark-leaselocator.webp";
import fantasyBlogIcon from "../assets/mark-fantasy-blog.webp";

const projectIcons: Record<(typeof projects)[number]["slug"], ImageMetadata> = {
  draftdna: draftdnaIcon,
  scoutdna: scoutdnaIcon,
  "job-search": hustlehunterIcon,
  "apartment-hunt": leaselocatorIcon,
  "fantasy-league-blog": fantasyBlogIcon,
};

const visibleProjects = projects.filter((project) => !("hidden" in project && project.hidden));
const total = String(visibleProjects.length).padStart(2, "0");
---

<section class="section projects" id="projects" aria-labelledby="projects-title">
  <div class="shell">
    <div class="projects__intro">
      <p class="section-label reveal"><span class="section-label__num">01</span>Projects</p>
      <h2 id="projects-title" class="display projects__title reveal reveal-delay-1">
        What I built <em>and shipped.</em>
      </h2>
      <p class="lead reveal reveal-delay-2">
        Data platforms and personal tools I designed, built, and still use.
      </p>
    </div>

    <ol class="project-list">
      {
        visibleProjects.map((project, index) => {
          const icon = projectIcons[project.slug];
          const liveLabel = project.href.includes("github.com") ? "View repo" : "Open live";
          return (
            <li class="project reveal" data-spotlight>
              <div class="project__meta">
                <span class="project__index">
                  {String(index + 1).padStart(2, "0")}{" "}
                  <span class="project__total">/ {total}</span>
                </span>
                <div class="project__mark">
                  <Image
                    class="project__icon"
                    src={icon}
                    alt=""
                    widths={[120, 180, 240]}
                    sizes="4.5rem"
                  />
                </div>
              </div>

              <div class="project__main">
                <h3 class="project__name">
                  <a href={project.href} target="_blank" rel="noopener noreferrer">
                    {project.title}
                  </a>
                </h3>
                <p class="project__blurb">{project.blurb}</p>
              </div>

              <div class="project__aside">
                <p class="project__detail">{project.detail}</p>
                <ul class="project__tags">
                  {project.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <div class="project__links">
                  <a class="project__link" href={project.href} target="_blank" rel="noopener noreferrer">
                    {liveLabel}
                    <span class="project__link-icon" aria-hidden="true">↗</span>
                  </a>
                  {project.repo !== project.href && (
                    <a
                      class="project__link project__link--muted"
                      href={project.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      GitHub
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
    card.addEventListener("pointermove", (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--x", `${event.clientX - rect.left}px`);
      card.style.setProperty("--y", `${event.clientY - rect.top}px`);
    });
  });
</script>

<style>
  .projects {
    scroll-margin-top: 1rem;
  }

  .projects__intro {
    display: grid;
    gap: 0;
  }

  @media (min-width: 900px) {
    .projects__intro {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "label label"
        "title lead";
      align-items: end;
      column-gap: 4rem;
    }

    .projects__intro .section-label {
      grid-area: label;
    }

    .projects__title {
      grid-area: title;
    }

    .projects__intro .lead {
      grid-area: lead;
      max-width: 22rem;
      margin: 0 0 0.6rem;
    }
  }

  .projects__title {
    font-size: clamp(3rem, 8vw, 6.5rem);
    max-width: 11ch;
  }

  .project-list {
    list-style: none;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .project {
    --x: 50%;
    --y: 50%;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "meta main"
      "aside aside";
    gap: 1.25rem 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(0.5rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }

  .project::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(420px circle at var(--x) var(--y), rgba(var(--sun-rgb), 0.09), transparent 70%),
      linear-gradient(90deg, rgba(241, 236, 227, 0.025), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--grad-sun);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease);
  }

  .project:hover::before {
    opacity: 1;
  }

  .project:hover::after {
    transform: scaleX(1);
  }

  .project__meta {
    grid-area: meta;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .project__index {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--sun);
  }

  .project__total {
    color: var(--ink-faint);
  }

  .project__mark {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    padding: 0.7rem;
    border-radius: 1rem;
    background: linear-gradient(145deg, #f4efe6, #dcd5c8);
    box-shadow:
      0 0 0 1px rgba(241, 236, 227, 0.1),
      0 18px 40px -18px rgba(0, 0, 0, 0.8);
    transition: transform 0.5s var(--ease);
  }

  .project:hover .project__mark {
    transform: rotate(-6deg) scale(1.06);
  }

  .project__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project__main {
    grid-area: main;
    min-width: 0;
    align-self: end;
  }

  .project__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .project__name a {
    text-decoration: none;
    display: inline-block;
    transition:
      transform 0.5s var(--ease),
      color 0.3s ease;
  }

  .project:hover .project__name a {
    transform: translateX(0.35rem);
    font-style: italic;
  }

  .project__blurb {
    margin: 0.85rem 0 0;
    max-width: 36rem;
    color: var(--ink);
    font-size: 1.02rem;
    font-weight: 300;
  }

  .project__aside {
    grid-area: aside;
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .project__detail {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 300;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project__tags li {
    padding: 0.28rem 0.6rem;
    border-radius: 0.35rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    transition: color 0.25s ease;
  }

  .project__link-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.5s var(--ease);
  }

  .project__link:hover .project__link-icon,
  .project:hover .project__link:not(.project__link--muted) .project__link-icon {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    transform: rotate(45deg);
  }

  .project__link--muted {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project__link--muted:hover {
    color: var(--ink);
  }

  @media (min-width: 960px) {
    .project {
      grid-template-columns: 6.5rem minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas: "meta main aside";
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }

    .project__main {
      align-self: start;
    }
  }
</style>
