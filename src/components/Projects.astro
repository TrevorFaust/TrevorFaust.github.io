---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { projects } from "../data/site";
import draftdnaIcon from "../assets/mark-draftdna.png";
import scoutdnaIcon from "../assets/mark-scoutdna.webp";
import hustlehunterIcon from "../assets/mark-hustlehunter.webp";
import leaselocatorIcon from "../assets/mark-leaselocator.webp";
import fantasyBlogIcon from "../assets/mark-fantasy-blog.webp";

const projectIcons: Record<(typeof projects)[number]["slug"], ImageMetadata> = {
  draftdna: draftdnaIcon,
  scoutdna: scoutdnaIcon,
  "job-search": hustlehunterIcon,
  "apartment-hunt": leaselocatorIcon,
  "fantasy-league-blog": fantasyBlogIcon,
};

const visibleProjects = projects.filter((project) => !("hidden" in project && project.hidden));
---

<section class="section projects" id="projects" aria-labelledby="projects-title">
  <div class="shell">
    <div class="projects__intro reveal">
      <p class="section-label">Projects</p>
      <h2 id="projects-title" class="display projects__title">
        What I built<br />and shipped.
      </h2>
      <p class="lead">
        Data platforms and personal tools I designed, built, and still use.
      </p>
    </div>

    <ol class="project-list">
      {
        visibleProjects.map((project, index) => {
          const icon = projectIcons[project.slug];
          return (
          <li class={`project reveal reveal-delay-${Math.min(index, 3)}`}>
            <div class="project__visual">
              <div class="project__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </div>
              <div class="project__mark">
                <Image
                  class="project__icon"
                  src={icon}
                  alt=""
                  widths={[160, 240, 320]}
                  sizes="(min-width: 720px) 8rem, 6.5rem"
                />
              </div>
            </div>
            <div class="project__body">
              <h3 class="project__name">{project.title}</h3>
              <p class="project__blurb">{project.blurb}</p>
              <p class="project__detail">{project.detail}</p>
              <ul class="project__tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
            <div class="project__links">
              <a class="project__link" href={project.href} target="_blank" rel="noopener noreferrer">
                {project.href.includes("github.com") ? "View repo" : "Open live"}
                <span aria-hidden="true">↗</span>
              </a>
              {project.repo !== project.href && (
                <a class="project__link project__link--muted" href={project.repo} target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              )}
            </div>
          </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .projects__title {
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    max-width: 12ch;
  }

  .project-list {
    list-style: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .project {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "visual body"
      "links links";
    align-items: center;
    column-gap: 0.85rem;
    row-gap: 1rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.15rem);
    background: rgba(255, 252, 247, 0.42);
    backdrop-filter: blur(8px);
    transition:
      transform 0.35s var(--ease),
      border-color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.35s var(--ease);
  }

  .project:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--accent-rgb), 0.32);
    background: rgba(255, 252, 247, 0.72);
    box-shadow: var(--shadow);
  }

  .project__visual {
    grid-area: visual;
    position: relative;
    width: 7.35rem;
    min-height: 6.5rem;
  }

  .project__index {
    position: absolute;
    top: -0.05rem;
    left: 0;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
    pointer-events: none;
  }

  .project__mark {
    width: 6.5rem;
    height: 6.5rem;
    margin: 0.55rem 0 0 1.05rem;
    background: transparent;
  }

  .project__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .project__body {
    grid-area: body;
    min-width: 0;
  }

  .project__links {
    grid-area: links;
  }

  @media (min-width: 720px) {
    .project {
      grid-template-columns: 9.25rem 1fr auto;
      grid-template-areas: "visual body links";
      column-gap: 0.75rem;
    }

    .project__visual {
      width: 9.25rem;
      min-height: 8rem;
    }

    .project__mark {
      width: 8rem;
      height: 8rem;
      margin: 0.65rem 0 0 1.55rem;
    }

    .project__links {
      align-self: center;
      padding-top: 0;
    }
  }

  .project__name {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.6vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .project__blurb {
    margin: 0;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .project__detail {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    max-width: 48rem;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }

  .project__tags li {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .project__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  @media (min-width: 860px) {
    .project__links {
      align-items: flex-end;
      min-width: 8.5rem;
      padding-top: 0;
    }
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 700;
    color: var(--accent);
  }

  .project__link:hover {
    color: var(--accent-soft);
  }

  .project__link--muted {
    color: var(--ink-faint);
    font-weight: 600;
  }
</style>
